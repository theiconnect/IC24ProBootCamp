@model RMSNextGen.Web.Models.ProductEditViewModel
@{
	ViewData["Title"] = "ViewProduct";
	Layout = "~/Views/Shared/_RMSLayout.cshtml";
}
<style>
	.form-label {
		margin-left: 10px;
		font-weight: bold;
	}
</style>

<div class="container">
	<div class="justify-content-between align-items-center">
		<hr class="mt-0" />
		<h4 class="text-secondary">Products/ViewProduct (View Only)</h4>
	</div>

	<div class="card shadow-sm p-3">
		<div class="row g-3">
			<div class="col-sm-5 mr-1">
				<label class="form-label">Product Code:</label>
				<p class="form-control-plaintext">@Model.ProductCode</p>
			</div>

			<div class="col-sm-5 mr-1">
				<label class="form-label">Product Name:</label>
				<p class="form-control-plaintext">@Model.ProductName</p>
			</div>

			<div class="col-sm-5 mr-1">
				<label class="form-label">Category:</label>
				<p class="form-control-plaintext">
					@ViewBag.ProductCategory
				</p>
			</div>

			<div class="col-sm-5 mr-1">
				<label class="form-label">Price Per Unit:</label>
				<p class="form-control-plaintext">@Model.PricePerUnit</p>
			</div>

			<div class="col-sm-5 mr-1">
				<label class="form-label">Threshold Limit:</label>
				<p class="form-control-plaintext">@Model.ThresholdLimit</p>
			</div>

			<div class="col-sm-5 mr-1">
				<label class="form-label">Unit of Measurement:</label>
				<p class="form-control-plaintext">
					@ViewBag.ProductUOM
				</p>
			</div>
		</div>
	</div>

	<div class="d-flex justify-content-end mt-3">
		<a class="btn btn-secondary" asp-action="ProductList" asp-controller="Product">Back to List</a>
	</div>
</div>
