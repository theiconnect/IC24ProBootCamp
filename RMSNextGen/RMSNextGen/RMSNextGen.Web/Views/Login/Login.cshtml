@model RMSNextGen.Web.Models.LoginViewModel
@{

	ViewData["Title"] = "Login";
	Layout = "~/Views/Shared/_LoginLayout.cshtml";

}


<div>
	<form method="post" asp-controller="Login" asp-action="Login">
		<div>
			<label>Email/Phone:</label>
			<input type="text" id="txtEmail" asp-for="Email" class="input-control" />
		</div>
		<div>
			<label>Password:</label>
			<input type="password" id="txtPassword" asp-for="Password" class="input-control" />
		</div>
		
		<div>
			<a asp-controller="Login" asp-action="SendOtp">Forgot Password</a>
		</div>
		<div>
			@* <input type="submit" value="" id="btnLogin"  class="btn-login" /> *@
			<button type="submit"  class="btn btn-info" style="margin-left:150px;text-align:center"><i class="bi bi-search"></i>Login -></button>
		</div>
	</form>
</div>
@if (ViewBag.Error != null)
{
	<div style="color:red; font-weight:bold;">
		@ViewBag.Error
	</div>
}
@if (ViewBag.UserRole != null)
{
	<div style="color:green; font-weight:bold;">
		<p>Welcome, you are logged in as: @ViewBag.UserRole</p>
	</div>
}


