
@* @model BookXpertAssignment.Models.EmployeeViewModel *@
@model List<BookXpertAssignment.Models.ModelsUsingEFCore.Employee>

@{
	ViewData["Title"] = "Employee List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<div class="container">
	<div class="justify-content-between align-items-center">
		<hr class="mt-0" />
		<h4 class="text-secondary">Employee/Search Employee</h4>
	</div>Search
	<form asp-action="SearchEmployee" asp-controller="Employee" method="post">
		<div class="card shadow-sm p-2">
			<div class="row g-3">
				<div class="row g-3">
					<i><b>Note:</b> Please serach By Name You Need</i>
				</div>
				<div class="col-sm-5 mr-1 px-2">
					<label for="EmployeeCode" class="form-label">Employee Name</label>
					@* <input type="text" class="form-control" asp-for="Name"> *@
					<input type="text" class="form-control" name="Name" value="@ViewBag.SearchName" />


				
				</div>
				
			</div>
		</div>
		<div class="d-flex justify-content-end gap-2 mt-3">
			
			<a class="btn btn-reset" asp-controller="Employee" asp-action="EmployeeList">
				<i class="bi bi-arrow-counterclockwise"></i>Clear
			</a>
			<button type="submit" class="btn btn-success">
				<i class="bi bi-search"></i> Search</button>
			<a class="btn btn-info" asp-controller="Employee" asp-action="AddNewEmployee">
				<i class="bi bi-plus-circle"></i> Add New Employee
			</a>
			
			
		</div>

	</form>
	@* <hr class="mt-0" /> *@
	<div class="table-responsive mt-2 p-2">
		<table class="table table-bordered table-hover shadow-sm">
			<thead class="table-dark">
				<tr>
					<th scope="col">S.NO</th>
					<th scope="col">Name</th>
					<th scope="col">Designation</th>
					<th scope="col">DOJ</th>
					<th scope="col">Salary</th>
					<th scope="col">Gender</th>
					<th scope="col">State</th>
					<th scope="col" class="text-center">Actions</th>
				</tr>
			</thead>
			<tbody>
				@{
					// int i = 1;
					int i = ((ViewBag.CurrentPage - 1) * 5) + 1;

				}
				@*without Pagination it will work
			 @foreach (var item in ViewBag.Employees) *@

				@foreach (var item in Model)
				{
					<tr>
						<td>@(i++)</td>
						@* <td>@item.Name</td>*@
						<td><a asp-controller="Employee" asp-action="EditEmployee" asp-route-Id="@(item.Id)">@item.Name</a></td>
						<td>@item.Designation</td>
						<td>@item.DateOfJoin</td>
						<td>@item.Salary</td>
						<td>@item.Gender</td>
						<td>@item.State?.Name</td>  <!-- Access the related State's Name property -->
						<td class="text-center">
							<a href="javascript:void(0);" onclick="confirmDelete(@item.Id)" class="btn btn-sm btn-warning">Delete</a>

							
						</td>
					</tr>
				}
				@if (i == 1)
				{
					<tr>
						<td colspan="8" align="center">No Employees available</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	 <div class="d-flex justify-content-between mt-2">
		@if (ViewBag.CurrentPage > 1)
		{
			<a class="btn btn-primary" 
			   asp-action="EmployeeList"
			   asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchName="@ViewBag.SearchName">Previous</a>
		}
		<span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
		@if (ViewBag.CurrentPage < ViewBag.TotalPages)
		{
			<a class="btn btn-primary" asp-controller="Employee" 
			   asp-action="EmployeeList"
			   asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchName=" @ViewBag.SearchName">Next</a>
		}
	</div>
 



</div>
@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
	<div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<script>
	function confirmDelete(employeeId) {
		if (confirm("Are you sure you want to delete this employee?")) {
			window.location.href = '/Employee/DeleteEmployee/' + employeeId;
		}
	}
</script>



